{
  "schemaVersion": 1,
  "id": "elyby_wardrobe",
  "version": "${version}",
  "name": "Ely.by Wardrobe & Custom Capes",
  "description": "Мод на гардероб, кастомні плащі, елітри та GIF-анімації з інтеграцією Ely.by",
  "authors": [ "Elyby Wardrobe Dev" ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.elyby.wardrobe.WardrobeClientMod"
    ]
  },
  "mixins": [
    "elyby_wardrobe.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=1.21",
    "java": ">=21"
  }
}
